# Copy this file to ".env" (same folder) and fill in your Supabase project values.
# Find them in Supabase: Project Settings -> API.
# The anon key is safe to use in a front-end app; do NOT put the service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
